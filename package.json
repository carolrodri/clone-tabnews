{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Projeto para aprender a programar",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && next dev",
    "test": "npm run services:up && npm run migrations:up && concurrently --names \"next,jest\" --hide next --kill-others --success command-jest \"npm:dev:test\" \"npm:test:run\" --verbose",
    "posttest": "npm run services:stop",
    "test:run": "wait-on http://localhost:3000 && dotenv -e .env.development -- jest --runInBand",
    "test:watch": "dotenv -e .env.development -- jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "dev:test": "next dev",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.2",
    "dotenv": "16.4.5",
    "dotenv-expand": "11.0.6",
    "next": "15.5.7",
    "next-connect": "1.0.0",
    "node-pg-migrate": "6.2.2",
    "pg": "8.11.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "swr": "2.2.5",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "commitizen": "4.3.0",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "dotenv-cli": "10.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.1.0",
    "husky": "9.1.4",
    "jest": "29.6.2",
    "prettier": "3.6.2",
    "wait-on": "9.0.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
